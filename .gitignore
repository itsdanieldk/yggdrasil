# Anchor patterns with a leading / wherever possible. An unanchored pattern also matches inside content/,
# which is how the previous template's `release`, `tags` and `build` entries kept a note of that name out of
# git, and so off the deployed site, without any error. Patterns with a dot, an underscore or an uppercase
# letter can never collide with a slug, so they are safe to leave unanchored.

# Build output
/src/*/bin/
/src/*/obj/
/tests/*/bin/
/tests/*/obj/
/dist/
/.bin/
TestResults/
/coverage/

# Deploy state and secrets
/.vercel
.env*

# Local agent state
/.claude
/CLAUDE.md
/CLAUDE.local.md
/AGENTS.md
/outputs/

# Editors and OS
.DS_Store
.idea/
.vs/
.vscode/*
!.vscode/settings.json
.ionide/
*.user

# Python
.venv/
__pycache__/
